<dialog class="dialog" id="env-dialog" aria-labelledby="env-title">
  <form class="dialog__body" data-env-form>
    <h2 class="dialog__title" id="env-title">Where is the crew?</h2>
    <p class="dialog__lede">This changes gravity, the delay to Earth and the exercises on offer. It never changes the health ranges.</p>
    <fieldset class="choice-list">
      <legend class="visually-hidden">Mission environment</legend>
      
      <label class="choice">
        <input type="radio" name="environment" value="Spacecraft">
        <span class="choice__label">Spacecraft</span>
      </label>
      
      <label class="choice">
        <input type="radio" name="environment" value="Space Station" checked>
        <span class="choice__label">Space Station</span>
      </label>
      
      <label class="choice">
        <input type="radio" name="environment" value="Rover">
        <span class="choice__label">Rover</span>
      </label>
      
      <label class="choice">
        <input type="radio" name="environment" value="Lunar Base">
        <span class="choice__label">Lunar Base</span>
      </label>
      
      <label class="choice">
        <input type="radio" name="environment" value="Mars Base">
        <span class="choice__label">Mars Base</span>
      </label>
      
    </fieldset>
    <p class="form-error" data-env-error hidden></p>
    <div class="dialog__actions">
      <button class="pill pill--ghost" type="button" data-close-dialog>Cancel</button>
      <button class="pill pill--primary" type="submit">Save location</button>
    </div>
  </form>
</dialog>


<dialog class="dialog" id="protocol-dialog" aria-labelledby="protocol-title">
  <div class="dialog__body">
    <h2 class="dialog__title" id="protocol-title">What to do now</h2>
    <ol class="steps" data-protocol-steps></ol>
    <div class="dialog__actions">
      <button class="pill pill--primary" type="button" data-close-dialog>Close</button>
    </div>
  </div>
</dialog>
<div class="toasts" data-toasts aria-live="polite"></div>

  

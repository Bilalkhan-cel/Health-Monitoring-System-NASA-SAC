            <button class="pill pill--ghost pill--small" type="button" data-scenario="lunar_base"><svg class="icon " aria-hidden="true" focusable="false"><use href="/static/vendor/lucide/sprite.svg#play"></use></svg>Run</button>
          </li>
          
          <li class="scenario">
            <div><p class="scenario__title">Critical BP event, 14-min comms delay</p><p class="card__meta">Blood pressure 186/118 with a 14-minute delay to Earth.</p></div>
            <button class="pill pill--ghost pill--small" type="button" data-scenario="critical_bp"><svg class="icon " aria-hidden="true" focusable="false"><use href="/static/vendor/lucide/sprite.svg#play"></use></svg>Run</button>
          </li>
          
        </ul>
      </div>

      <form class="demo__block" data-force-form>

        <li class="row"><span class="row__label">Firmware</span><span class="row__value">1.0.0</span></li>
        <li class="row"><span class="row__label">Wi-Fi signal</span>
          <span class="row__value">-57 dBm · strong</span></li>
      </ul>
      <form class="set__rows" data-device-form>

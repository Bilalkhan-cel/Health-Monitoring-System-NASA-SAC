        </div>
        <div class="set__row">
          <span class="set__label" id="glucose-label">Blood sugar</span>
          <div class="segmented" role="radiogroup" aria-labelledby="glucose-label">
            
            <label class="segmented__item segmented__radio"><input type="radio" name="glucose_unit" value="mg/dL" checked>mg/dL</label>
            
            <label class="segmented__item segmented__radio"><input type="radio" name="glucose_unit" value="mmol/L">mmol/L</label>
            
          </div>
        </div>
        <label class="set__row switch">
          <span><span class="set__label">Voice cues</span><span class="set__hint">Spoken counts and prompts during exercise and checks.</span></span>
          <input type="checkbox" role="switch" name="voice_cues" checked>
        </label>
        <label class="set__row switch">
          <span><span class="set__label">Reduce motion</span><span class="set__hint">Calmer animations everywhere, even if your computer doesn't ask for it.</span></span>
          <input type="checkbox" role="switch" name="reduced_motion">
        </label>

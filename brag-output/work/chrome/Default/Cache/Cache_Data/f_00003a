      </form>
      
      <form class="calibrate" data-calibrate-form>
        <h3 class="set__sub">Calibrate temperature</h3>
        <p class="card__meta">Keep the probe under your arm until it has settled, take a reading with a reference thermometer and type it here. The difference (at most 2 °C) replaces the default offset. Current offset: <strong>+0.60 °C</strong>.
          Probe now: <strong data-probe-state>settled</strong>.</p>
        <div class="calibrate__row">
          <label class="field"><span class="field__label">Thermometer reading (°C)</span>
            <input class="field__input" name="reference_c" inputmode="decimal" required></label>
          <button class="pill pill--ghost pill--small" type="submit">Calibrate</button>
        </div>
        
        <p class="form-error" data-calibrate-message hidden></p>
      </form>
      
      
